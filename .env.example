# ============================================================================
# Prime Agent on Cloudera AI: environment contract
#
# Copy to .env for Docker Desktop. In Cloudera AI Workbench, set the same
# names as project or application environment variables. Every service and
# script reads ONLY the names listed here (services/common/env.py is the
# single reader). Values differ per target; names and code do not.
# ============================================================================

# ---- Target -----------------------------------------------------------------
# local | cai   Informational only; nothing branches on it except log labels.
DEPLOY_TARGET=local
# Workbench sets CDSW_APP_PORT itself and expects apps on 127.0.0.1.
# Locally the entrypoint defaults BIND_HOST to 0.0.0.0 so Docker can publish.
CDSW_APP_PORT=8080
BIND_HOST=0.0.0.0

# ---- Prime Agent ------------------------------------------------------------
# Agent dir (settings.json, models.json, sessions, harness state). Persistent
# in both targets: a named volume locally, the project filesystem in Workbench.
PRIME_AGENT_CODING_AGENT_DIR=/home/cdsw/.prime/agent
# Root (orchestrator) and child (delegated) models as provider/model selectors.
# Mistral status on 2026-10-20: Magistral is retired; reasoning now lives in
# mistral-large-latest (Large 4, 1M context) and mistral-medium-latest
# (Medium 3.5, 256K). Ministral 3 8B is ministral-8b-2512 (256K).
# Prime Agent's catalog also lists these -latest aliases. These definitions
# override the catalog, so keep the windows honest for the model you pick.
ROOT_MODEL=mistral/mistral-large-latest
ROOT_THINKING=medium
ROOT_CONTEXT_WINDOW=262144
ROOT_MAX_TOKENS=16384
CHILD_MODEL=mistral/ministral-8b-latest
CHILD_THINKING=low
CHILD_CONTEXT_WINDOW=262144
CHILD_MAX_TOKENS=16384
# Recursion limits enforced by the harness.
RLM_MAX_DEPTH=2
MAX_CHILDREN=6
# Compact a session once its context passes this many tokens. Keeps every model
# call small: Mistral's per-minute token budget (2M on our key) is shared by the
# root and all children.
COMPACTION_THRESHOLD_TOKENS=96000
# Optional Impala MCP server (Streamable HTTP). Empty: none; the lakehouse skill is the data path.
IMPALA_MCP_URL=
IMPALA_MCP_TOKEN=
# Where the investigation skills live (mounted or checked out with the project).
SKILLS_DIR=/home/cdsw/skills
# Working directory for investigation sessions. render_config writes the full
# investigation method there as AGENTS.md, which prime-agent puts in the system
# prompt; children write their result files there too. Kept out of git.
AGENT_WORKDIR=/home/cdsw/data/agent
# The agent kernel (PRIME_AGENT_KERNEL_PYTHON) must import each executable skill, or
# prime-agent disables it with only a warning. Its venv is root-owned, so the skills'
# src dirs go on PYTHONPATH (inherited by the daemon and kernel).
PYTHONPATH=/home/cdsw/skills/lakehouse/src:/home/cdsw/skills/atlas/src

# ---- Mistral (root model, and children when CHILD_MODEL starts with mistral/) --
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai

# ---- Impala (Cloudera Data Warehouse or local quickstart) ---------------------
IMPALA_HOST=impalad
IMPALA_PORT=21050
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_DATABASE=meridian_financial
# NOSASL for the local quickstart, LDAP for CDW with a workload user, GSSAPI for Kerberos
IMPALA_AUTH_MECHANISM=NOSASL
# CDW virtual warehouses use HTTP transport on 443 with SSL; the quickstart uses binary on 21050
IMPALA_USE_HTTP=false
IMPALA_HTTP_PATH=cliservice
IMPALA_USE_SSL=false
IMPALA_QUERY_TIMEOUT_S=600
IMPALA_MAX_ROWS=5000

# ---- Metadata (Atlas) --------------------------------------------------------
# stub | atlas   stub reads config/atlas-stub.json so local runs need no Atlas
METADATA_BACKEND=stub
ATLAS_URL=
ATLAS_USER=
ATLAS_PASSWORD=
ATLAS_STUB_PATH=/home/cdsw/config/atlas-stub.json

# ---- MCP bridge (services/bridge) ---------------------------------------------
# Static bearer the Mistral Studio connector sends in its headers.
BRIDGE_BEARER_TOKEN=change-me
BRIDGE_DATA_DIR=/home/cdsw/data/bridge
INVESTIGATION_TIMEOUT_S=3600
# Public base URL the connector uses (tunnel locally, application URL in Workbench).
BRIDGE_PUBLIC_URL=

# ---- Investigation console (services/console) ---------------------------------
CONSOLE_REFRESH_S=5

# ---- Data generation (data/) ---------------------------------------------------
DATA_SCALE=2000000
DATA_SEED=20261027
DATA_STAGING_DIR=/home/cdsw/data/staging

# ---- Local-only conveniences (ignored in Workbench) -----------------------------
# cloudflared tunnel token so Mistral Studio can reach the local bridge
CLOUDFLARE_TUNNEL_TOKEN=

# Impala quickstart memory limit; Docker Desktop on this machine has 7.7 GB
IMPALA_MEM_LIMIT=2gb

# Host ports for the local bridge and console (container ports stay 8080/8090)
BRIDGE_PORT=18080
CONSOLE_PORT=18090

# Apple Silicon only: native arm64 runtime for bridge/console (make image-local).
# Docker Desktop stays on Rosetta for Impala. Leave both unset on Intel and in Workbench.
# RUNTIME_IMAGE=prime-agent-runtime:0.10.0-local-arm64
# RUNTIME_PLATFORM=linux/arm64
